{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "KubernetesInfo": {
    "Namespaces": [ "app", "app-services", "app-consumers", "app-jobs" ],
    "ConsumersNamespace": "app-consumers",
    "JobsNamespace": "app-jobs",
    "ApplicationNamespaces": [ "app", "app-services" ],
    "KubeConfigPath": ""
  },
  "Authentication": {
    "ValidIssuers": [
      "https://auth.example.com"
    ],
    "Authority": "https://auth.example.com",
    "MetadataAddress": "https://auth.example.com/.well-known/openid-configuration",
    "EnablePIILogging": true,
    "OAuthProxyCookieDomain": "localhost"
  },
  "Authorization": {
    "AdminGroups": [ "Dashboard-Admin", "Dashboard-Leads" ]
  },
  "ArgoWorkflows": {
    "ApiBaseUrl": "http://localhost:2746",
    "BearerToken": "",
    "ServiceAccountTokenPath": "/var/run/secrets/kubernetes.io/serviceaccount/token"
  },
  "Elasticsearch": {
    "Url": "https://localhost:9200",
    "IndexPattern": "logs-*",
    "TopicErrors": {
      "DefaultHoursBack": 168,
      "Ingest": {
        "SharedKey": "",
        "LogPayload": true,
        "LogPayloadMaxChars": 4000
      }
    }
  },
  "Prometheus": {
    "Url": "http://localhost:9090",
    "TimeoutSeconds": 10,
    "Enabled": true
  },
  "PrometheusAlerting": {
    "ProposalNamespace": "app"
  },
  "TopicAlerting": {
    "ElasticIndexAlias": "kube-topic-alert-config",
    "Email": {
      "Smtp": "localhost:25",
      "SmtpFrom": "noreply@localhost",
      "DashboardBaseUrl": "http://localhost:4200"
    }
  }
}
