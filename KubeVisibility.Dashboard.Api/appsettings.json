{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "KubernetesInfo": {
    "Namespaces": [ "app", "app-services", "app-consumers", "app-jobs" ],
    "ConsumersNamespace": "app-consumers",
    "JobsNamespace": "app-jobs",
    "ApplicationNamespaces": [ "app", "app-services" ],
    "ManagedLabelPrefix": "kube-visibility.io",
    "EnvironmentVariables": [ "ASPNETCORE_ENVIRONMENT", "Logging__LogLevel__Default" ],
    "CacheDurationSeconds": 30
  },
  "Authentication": {
    "SchemeName": "JwtBearer",
    "ValidAudiences": [
      "kubernetes-dashboard"
    ],
    "Scopes": [
      "openid",
      "profile",
      "email"
    ],
    "ValidateIssuerSigningKey": true,
    "RequireSignedTokens": true,
    "RequireHttpsMetadata": true,
    "SaveToken": true,
    "UseSecurityTokenValidators": true,
    "EnablePIILogging": false,
    "OAuthProxyCookieName": "_oauth2_proxy_kube_dashboard",
    "OAuthProxyCookiePath": "/",
    "OAuthProxyCookieDomain": null
  },
  "Authorization": {
    "AdminGroups": [ "Dashboard-Admin", "Dashboard-Leads" ]
  },
  "ArgoWorkflows": {
    "ApiBaseUrl": "",
    "BearerToken": "",
    "ServiceAccountTokenPath": "/var/run/secrets/kubernetes.io/serviceaccount/token"
  },
  "Kafka": {
    "BootstrapServers": "",
    "Ssl": {
      "Enabled": true,
      "CaCertificatePath": "/etc/ssl/certs/kafka/ca.crt"
    },
    "Consumer": {
      "MaxMessagesPerSearch": 5000,
      "DefaultTimeoutSeconds": 60,
      "MaxDaysBack": 60,
      "MaxRangeDays": 7,
      "DefaultRangeDays": 1,
      "MaxConcurrentPartitions": 5,
      "MaxDegreeOfParallelism": 10,
      "StreamBatchSize": 1,
      "ProgressReportIntervalMs": 900,
      "ConsumeTimeoutMs": 1000,
      "FetchMinBytes": 524288,
      "FetchMaxBytes": 52428800,
      "MaxPartitionFetchBytes": 10485760,
      "FetchWaitMaxMs": 600,
      "SocketReceiveBufferBytes": 10485760,
      "ReceiveMessageMaxBytes": 104857600
    }
  },
  "Elasticsearch": {
    "Url": "",
    "IndexPattern": "logs-*",
    "TopicErrors": {
      "DefaultHoursBack": 168,
      "Ingest": {
        "DedupeIndexAlias": "kube-topic-error-dedupe",
        "EventIdIndexAlias": "kube-topic-error-eventid",
        "SharedKey": "",
        "LogPayload": true,
        "LogPayloadMaxChars": 40000,
        "DedupeWindowMinutes": 60
      }
    }
  },
  "Prometheus": {
    "Url": "http://prometheus-kube-prometheus-prometheus.monitoring:9090",
    "TimeoutSeconds": 10,
    "Enabled": true
  },
  "PrometheusAlerting": {
    "ProposalNamespace": "app"
  },
  "AdminAudit": {
    "Enabled": true,
    "ElasticIndexAlias": "kube-admin-audit",
    "MaxRequestBodyChars": 4000,
    "DefaultQueryRangeDays": 7,
    "MaxQueryRangeDays": 90
  },
  "TopicAlerting": {
    "ElasticIndexAlias": "kube-topic-alert-config",
    "Email": {
      "Smtp": "localhost:25",
      "SmtpFrom": "noreply@localhost",
      "DashboardBaseUrl": "http://localhost:4200"
    }
  },
  "AllowedHosts": "*"
}
