{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "KubernetesInfo": {
    "Namespaces": [ "app", "app-services", "app-consumers", "app-jobs" ],
    "ConsumersNamespace": "app-consumers",
    "JobsNamespace": "app-jobs",
    "ApplicationNamespaces": [ "app", "app-services" ]
  },
  "AllowedHosts": "*",
  "Authentication": {
    "ValidIssuers": [
      "https://auth.example.com"
    ],
    "Authority": "https://auth.example.com",
    "MetadataAddress": "https://auth.example.com/.well-known/openid-configuration",
    "EnablePIILogging": false,
    "OAuthProxyCookieDomain": "dashboard.example.com"
  },
  "Authorization": {
    "AdminGroups": [ "Dashboard-Admin", "Dashboard-Leads" ]
  },
  "ArgoWorkflows": {
    "ApiBaseUrl": "https://argo.example.com",
    "BearerToken": null,
    "ServiceAccountTokenPath": "/var/run/secrets/kubernetes.io/serviceaccount/token"
  },
  "PrometheusAlerting": {
    "ProposalNamespace": "app"
  },
  "Kafka": {
    "Consumer": {
      "MaxDaysBack": 60,
      "MaxRangeDays": 7,
      "DefaultRangeDays": 1
    }
  },
  "TopicAlerting": {
    "Email": {
      "Smtp": "mail.example.com:25",
      "SmtpFrom": "alerts@example.com",
      "DashboardBaseUrl": "https://dashboard.example.com"
    }
  }
}
